# Configurações do servidor
PORT=3000
NODE_ENV=development

# Configurações da API
API_PREFIX=/api/v1

# Configurações de rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações de sessões
SESSIONS_DIR=./sessions
UPLOADS_DIR=./uploads

# Configurações de webhook (opcional)
WEBHOOK_URL=http://localhost:3000
WEBHOOK_SECRET=

# Configurações de log
LOG_LEVEL=info

# Chave da API (opcional, para autenticação)
API_KEY=your-api-key-here

# Configurações do Botpress
BOTPRESS_URL=http://localhost:3001
BOTPRESS_TOKEN=your-botpress-token-here

# Configurações de segurança
JWT_SECRET=your-jwt-secret-here

# Configurações de banco de dados (se necessário)
# DATABASE_URL=mongodb://localhost:27017/whatsapp-bot
# REDIS_URL=redis://localhost:6379

